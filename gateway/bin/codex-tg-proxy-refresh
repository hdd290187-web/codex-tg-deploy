#!/usr/bin/env python3
from __future__ import annotations

import base64
import json
import os
import re
import tempfile
import time
import urllib.request
from pathlib import Path


ROOT = Path("/etc/codex-tg-proxy")
CONFIG = ROOT / "config.yaml"
STATUS = ROOT / "refresh-status.json"
MAX_BYTES = 5 * 1024 * 1024
SCHEMES = {
    "anytls", "hysteria", "hysteria2", "hy2", "mieru", "naive+https", "socks",
    "socks5", "ss", "ssh", "ssr", "trojan", "tuic", "vless", "vmess", "wireguard",
}


def save_status(ok: bool, detail: str) -> None:
    payload = json.dumps(
        {"ok": ok, "detail": detail[:120], "checked_at": int(time.time())},
        separators=(",", ":"),
    ).encode()
    descriptor, name = tempfile.mkstemp(prefix=".refresh-status.", dir=ROOT)
    temporary = Path(name)
    try:
        with os.fdopen(descriptor, "wb") as output:
            output.write(payload)
            output.flush()
            os.fsync(output.fileno())
        temporary.chmod(0o600)
        temporary.replace(STATUS)
    finally:
        temporary.unlink(missing_ok=True)


def valid_subscription(content: bytes) -> bool:
    try:
        text = content.decode("utf-8-sig").strip()
    except UnicodeDecodeError:
        return False
    if re.search(r"(?m)^\s*proxies\s*:", text) and re.search(
        r"(?m)^\s*-\s+(?:name|type)\s*:", text
    ):
        return True

    def has_uri(value: str) -> bool:
        for line in value.replace("\r", "").split("\n"):
            match = re.match(r"^([A-Za-z][A-Za-z0-9+.-]*)://\S+$", line.strip())
            if match and match.group(1).lower() in SCHEMES:
                return True
        return False

    if has_uri(text):
        return True
    compact = "".join(text.split())
    if not re.fullmatch(r"[A-Za-z0-9_+/=-]+", compact or ""):
        return False
    padded = compact + "=" * (-len(compact) % 4)
    for decoder in (base64.b64decode, base64.urlsafe_b64decode):
        try:
            if has_uri(decoder(padded).decode("utf-8")):
                return True
        except Exception:
            continue
    return False


def main() -> None:
    import importlib.machinery
    import importlib.util
    import subprocess
    loader = importlib.machinery.SourceFileLoader('proxy_download', str(Path(__file__).with_name('codex-tg-proxy-setup')))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    helper = importlib.util.module_from_spec(spec)
    loader.exec_module(helper)
    config = json.loads(CONFIG.read_text('utf-8'))
    provider = config['proxy-providers']['subscription']
    url_file = ROOT / 'subscription-url'
    url = url_file.read_text() if url_file.exists() else str(provider['url'])
    target = ROOT / 'providers/subscription.yaml'
    old = target.read_bytes()
    old_config = CONFIG.read_bytes()
    try:
        content = helper.download(url, MAX_BYTES)
        if not valid_subscription(content):
            raise RuntimeError('unsupported subscription format')
        # Validate a candidate file before replacing the cache used by Mihomo.
        with tempfile.TemporaryDirectory(prefix='.validate-', dir=ROOT) as name:
            candidate = Path(name) / 'subscription.yaml'
            candidate.write_bytes(content)
            check_config = json.loads(json.dumps(config))
            check_config['proxy-providers']['subscription'] = {**provider, 'type': 'file', 'path': str(candidate)}
            check_config['proxy-providers']['subscription'].pop('url', None)
            check = Path(name) / 'config.json'
            check.write_text(json.dumps(check_config))
            subprocess.run(['/opt/codex-tg-proxy/mihomo', '-t', '-d', str(ROOT), '-f', str(check)],
                           check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=45)
        helper.atomic_write(url_file, url.encode())
        provider.update(type='file')
        provider.pop('url', None)
        provider.pop('interval', None)
        helper.atomic_write(target, content)
        helper.atomic_write(CONFIG, json.dumps(config).encode())
        # Reload config too, migrating old HTTP providers to pinned file mode.
        request = urllib.request.Request('http://127.0.0.1:9090/configs',
            data=json.dumps({'path': str(CONFIG)}).encode(), method='PUT', headers={'Content-Type': 'application/json'})
        with urllib.request.build_opener(urllib.request.ProxyHandler({})).open(request, timeout=45) as response:
            if response.status not in {200, 204}:
                raise RuntimeError('Mihomo refresh failed')
        save_status(True, 'subscription refreshed')
    except Exception as exc:
        helper.atomic_write(target, old)
        helper.atomic_write(CONFIG, old_config)
        try:
            request = urllib.request.Request('http://127.0.0.1:9090/configs',
                data=json.dumps({'path': str(CONFIG)}).encode(), method='PUT', headers={'Content-Type': 'application/json'})
            with urllib.request.build_opener(urllib.request.ProxyHandler({})).open(request, timeout=45):
                pass
        except Exception:
            pass
        save_status(False, type(exc).__name__)
        # Subscription URLs can be in exception strings; never print traceback.
        raise SystemExit('Proxy refresh failed: ' + type(exc).__name__) from None


if __name__ == "__main__":
    main()
