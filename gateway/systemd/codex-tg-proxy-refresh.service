[Unit]
Description=Refresh Codex TG Mihomo subscription
After=network-online.target codex-tg-proxy.service
Requires=codex-tg-proxy.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/etc/codex-tg-proxy
ExecStart=/opt/codex-tg/current/bin/codex-tg-proxy-refresh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/codex-tg-proxy
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
