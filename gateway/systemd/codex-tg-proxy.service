[Unit]
Description=Codex TG local Telegram proxy (Mihomo)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=root
WorkingDirectory=/etc/codex-tg-proxy
ExecStartPre=/opt/codex-tg-proxy/mihomo -t -d /etc/codex-tg-proxy -f /etc/codex-tg-proxy/config.yaml
ExecStart=/opt/codex-tg-proxy/mihomo -d /etc/codex-tg-proxy -f /etc/codex-tg-proxy/config.yaml
Restart=on-failure
RestartSec=10
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/codex-tg-proxy
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
